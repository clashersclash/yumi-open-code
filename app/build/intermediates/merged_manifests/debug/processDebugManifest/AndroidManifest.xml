<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.rumi.controller"
    android:versionCode="6"
    android:versionName="1.0.1" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="36" />

    <!-- 🔥 FIX: Added permissions to keep the app alive in the background -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <queries>
        <package android:name="com.spotify.music" />
    </queries>

    <application
        android:allowBackup="false"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:label="Yumi Controller Plug-in"
        android:theme="@style/AppTheme" >
        <activity
            android:name="com.rumi.controller.MainActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.rumi.controller.PlayRequestReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.rumi.voiceassistant.PLAY_SPOTIFY" />
                <action android:name="com.rumi.voiceassistant.MEDIA_CONTROL" />
                <action android:name="com.rumi.voiceassistant.VOLUME_CONTROL" />
            </intent-filter>
        </receiver>

        <service
            android:name="com.rumi.controller.SpotifyAccessibilityService"
            android:exported="true"
            android:label="Yumi Controller Plug-in"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" >
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
        <service
            android:name="com.rumi.controller.RumiForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>